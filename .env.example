# Desarrollo local: mysql://USUARIO:CONTRASENA@localhost:3306/aut_ins_local
# Producción: cadena de una MySQL externa accesible desde Render, por ejemplo Azure Database for MySQL.
# Los caracteres especiales de usuario y contraseña deben codificarse para URL.
DATABASE_URL="mysql://USUARIO:CONTRASENA@HOST:3306/AUT_INS"

# Autenticación
JWT_SECRET="REEMPLAZAR_CON_UN_SECRETO_SEGURO"
JWT_EXPIRES_IN="1h"

# Notificaciones exclusivas para aspirantes
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY=""

# Aplicación
PORT="3000"
NODE_ENV="development"
# En producción usa uno o más orígenes HTTPS separados por coma. Render autoriza
# automáticamente su propio dominio cuando esta variable no está definida.
CORS_ORIGIN="*"
