{
  "name": "aut-ins-api",
  "version": "0.1.0",
  "private": true,
  "description": "API modular para la administracion del proceso de admision e inscripcion escolar AUT-INS.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:structure": "node scripts/check-structure.cjs",
    "check": "npm run check:structure && npm run typecheck"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
